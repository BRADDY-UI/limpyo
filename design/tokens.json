{
  "$description": "Limpyo 'Night Route' design tokens. Single source of truth for the Android theme and the admin-web Tailwind theme. Edit here, then run: node design/scripts/build-tokens.mjs",
  "color": {
    "night": {
      "ground": "#0B1210",
      "surface": "#141E1A",
      "raised": "#1E2B26",
      "border": "#2C3C36",
      "divider": "#26352F",
      "ink": "#EAF5EF",
      "muted": "#9DB3A8",
      "accent": "#B6F23A",
      "accentStrong": "#B6F23A",
      "onAccent": "#0B1210",
      "accentContainer": "#25331B",
      "warning": "#FFC15E",
      "warningContainer": "#3A2E12",
      "danger": "#FF9A73",
      "dangerContainer": "#3B2018",
      "info": "#7CC4FF",
      "infoContainer": "#15283A",
      "scrim": "#99000000"
    },
    "day": {
      "ground": "#F4F7F5",
      "surface": "#FFFFFF",
      "raised": "#EAF0EC",
      "border": "#D3DDD8",
      "divider": "#E2E9E5",
      "ink": "#0B1210",
      "muted": "#4E6159",
      "accent": "#B6F23A",
      "accentStrong": "#3D6B00",
      "onAccent": "#0B1210",
      "accentContainer": "#E6F4D0",
      "warning": "#8A5300",
      "warningContainer": "#FBEBD2",
      "danger": "#B3261E",
      "dangerContainer": "#FBE3E0",
      "info": "#0B5CAD",
      "infoContainer": "#DDEBF9",
      "scrim": "#99000000"
    },
    "category": {
      "night": {
        "biodegradable": "#4DD6C1",
        "recyclable": "#7CC4FF",
        "residual": "#C9D1CD",
        "special": "#FF9A73",
        "ewaste": "#C8A6FF"
      },
      "day": {
        "biodegradable": "#00695C",
        "recyclable": "#0B5CAD",
        "residual": "#4E5A55",
        "special": "#B3261E",
        "ewaste": "#6A3FB5"
      }
    }
  },
  "font": {
    "display": "Space Grotesk",
    "ui": "Inter"
  },
  "type": {
    "display":    { "font": "display", "size": 34, "line": 40, "weight": 700 },
    "headline":   { "font": "display", "size": 28, "line": 34, "weight": 700 },
    "title":      { "font": "display", "size": 22, "line": 28, "weight": 700 },
    "titleSmall": { "font": "ui", "size": 17, "line": 24, "weight": 600 },
    "body":       { "font": "ui", "size": 16, "line": 24, "weight": 400 },
    "bodyStrong": { "font": "ui", "size": 16, "line": 24, "weight": 600 },
    "label":      { "font": "ui", "size": 14, "line": 20, "weight": 500 },
    "caption":    { "font": "ui", "size": 13, "line": 18, "weight": 500 },
    "overline":   { "font": "ui", "size": 12, "line": 16, "weight": 600, "tracking": 0.08 }
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "x3": 32, "x4": 40, "x5": 48, "x6": 64, "screen": 20 },
  "radius": { "small": 8, "medium": 12, "large": 20, "sheet": 28 },
  "size": {
    "touchMin": 48,
    "icon": 24,
    "iconSmall": 20,
    "iconLarge": 48,
    "dot": 8,
    "sheetHandleWidth": 40,
    "sheetHandleHeight": 4,
    "touchDriver": 56,
    "pill": 48,
    "button": 52,
    "chip": 32,
    "textField": 56,
    "bottomNav": 72,
    "sheetPeek": 148,
    "border": 1,
    "focusRing": 2
  },
  "motion": {
    "durationFast": 100,
    "durationShort": 160,
    "durationMedium": 240,
    "durationLong": 360,
    "easeStandard": [0.2, 0, 0, 1],
    "easeEnter": [0.16, 1, 0.3, 1],
    "easeExit": [0.3, 0, 1, 1],
    "springDefault": { "dampingRatio": 0.9, "stiffness": 400 },
    "springSheet": { "dampingRatio": 0.85, "stiffness": 300 },
    "springSnappy": { "dampingRatio": 0.7, "stiffness": 700 }
  }
}
